# Copy this file to .env and fill in real values. Never commit .env.

# --- Alarm Management API simulator ---
ALARM_API_BASE_URL=http://localhost:8000
ALARM_API_TOKEN=replace-me
ALARM_API_TIMEOUT_SECONDS=10
ALARM_API_MAX_RETRIES=3

# --- MCP server ---
MCP_SERVER_URL=http://localhost:9000/mcp

# --- LLM (Gemini). Leave LLM_PROVIDER=offline to run without a key. ---
LLM_PROVIDER=offline
LLM_MODEL=replace-me
LLM_API_KEY=replace-me

# --- RAG ---
DOCUMENT_PATH=./rag/documents
VECTOR_STORE_URL=replace-me

# --- Logging ---
LOG_LEVEL=INFO
