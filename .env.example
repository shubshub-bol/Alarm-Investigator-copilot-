# Copy this file to .env and fill in real values. Never commit .env.
#
# Docker: a .env is optional. `docker compose up --build` works without one (language model off, demo tokens).
# When .env exists, Compose takes the tokens, LLM_* and LOG_LEVEL from it; the addresses between the
# containers are set in docker-compose.yml, and ALARM_API_TOKEN is used on both sides of the Alarm API.

# --- Alarm Management API simulator (server side) ---
SIM_API_TOKEN=replace-me                 # token the simulator accepts

# --- Alarm API connector (used by the MCP server) ---
ALARM_API_BASE_URL=http://localhost:8000
ALARM_API_TOKEN=replace-me               # must equal SIM_API_TOKEN
ALARM_API_TIMEOUT_SECONDS=10
ALARM_API_MAX_RETRIES=3

# --- MCP server ---
MCP_HOST=127.0.0.1
MCP_PORT=9000
MCP_AUTH_TOKEN=replace-me                # clients send 'Authorization: Bearer <token>'
MCP_SERVER_URL=http://localhost:9000/mcp

# --- LLM. LLM_PROVIDER: gemini | openrouter | offline (offline runs without a key). ---
# gemini:     LLM_MODEL=gemini-flash-latest and a Google AI Studio key
# openrouter: LLM_MODEL=<vendor/model> and an OpenRouter key, e.g. nvidia/nemotron-3-super-120b-a12b:free
#             (free models: 20 requests/min, 50/day under $10 of credits; a question uses about 3)
LLM_PROVIDER=offline
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=replace-me
LLM_THINKING_LEVEL=LOW                  # MINIMAL/LOW/MEDIUM/HIGH; LOW measured 9s vs 21s default, same quality

# --- Copilot backend: saved chats (SQLite file, created on first start) ---
COPILOT_DB_PATH=.data/copilot.sqlite3

# --- RAG ---
# The document index is stored as local files (rag/index), so no vector database URL is needed.
DOCUMENT_PATH=./rag/documents

# --- Logging ---
LOG_LEVEL=INFO
